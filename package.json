{
  "name": "tutortrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.server.local --import tsx scripts/dev-api.ts",
    "build": "npm run check:server && vite build",
    "check:server": "node scripts/check-server-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test services/*.test.ts server/*.test.ts",
    "test:server": "tsx --test server/*.test.ts",
    "rules:test": "npm --prefix rules-tests test"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^7.5.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "firebase": "^10.7.2",
    "firebase-admin": "13.10.0",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.7",
    "undici": "6.29.1",
    "uuid": "11.1.1"
  }
}
