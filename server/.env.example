# Server-only Vercel environment variables. Never prefix credentials with VITE_.
FIREBASE_PROJECT_ID=tutortrack-f801e
FIREBASE_CLIENT_EMAIL=your-service-account@tutortrack-f801e.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
APP_URL=https://tutor-track-ten.vercel.app
# Generate at least 32 random characters; same value in the GitHub Actions secret.
CRON_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Alternative to the three FIREBASE_* credential fields above:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"tutortrack-f801e","client_email":"...","private_key":"..."}
# If VITE_FIREBASE_PROJECT_ID exists, it must match this service account project.
