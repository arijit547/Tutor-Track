{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "output/server-check",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "sourceMap": false
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "services/studentBilling.ts", "types.ts"],
  "exclude": ["node_modules", "output", "server/**/*.test.ts"]
}
